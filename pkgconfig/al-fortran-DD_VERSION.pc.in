prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: al-fortran-@DD_VERSION@
Version: @PROJECT_VERSION@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Requires: al-core >= @AL_CORE_VERSION@
Cflags: -I${includedir}/fortran
Libs: -L${libdir} -lal-fortran-@DD_VERSION@@DD_PC_VERSION_SYMBOL_FLAG@ -Wl,-rpath,${libdir}
